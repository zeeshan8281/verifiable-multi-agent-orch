{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@verified-handoff/*": ["lib/verified-handoff/*"]
    }
  },
  "include": ["lib/**/*", "agents/**/*"],
  "exclude": ["node_modules", "web", "dist"]
}
