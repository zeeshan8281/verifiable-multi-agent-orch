{
  "name": "@layr-labs/eigen-design",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/components/ui/*.d.ts",
        "default": "./dist/components/ui/*.js"
      },
      "require": {
        "types": "./dist/components/ui/*.d.cts",
        "default": "./dist/components/ui/*.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/lib/utils.d.ts",
        "default": "./dist/lib/utils.js"
      },
      "require": {
        "types": "./dist/lib/utils.d.cts",
        "default": "./dist/lib/utils.cjs"
      }
    },
    "./styles": "./dist/styles/globals.css",
    "./assets/*": "./dist/assets/*"
  },
  "files": [
    "dist",
    "skills.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "geist": "^1.7.0",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsup && mkdir -p dist/styles dist/fonts && cp src/styles/globals.css dist/styles/globals.css && cp src/fonts/*.woff2 dist/fonts/ && rm -rf dist/assets && cp -r src/assets dist/assets",
    "build:watch": "tsup --watch",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  }
}